# Rendered at container start by the nginx image (envsubst on ${ENV_VARS} only).
#   BACKEND_URL   e.g. https://tb-xray-api.internal.<env>.azurecontainerapps.io   (local: http://backend:8000)
#   BACKEND_HOST  host name the backend ingress expects                          (local: backend)
# JSON access log: total time, backend time and the request id (the backend logs the same id).
log_format json escape=json '{"time":"$time_iso8601","request_id":"$request_id","method":"$request_method",'
    '"path":"$uri","status":$status,"bytes":$body_bytes_sent,"duration_s":$request_time,'
    '"upstream_status":"$upstream_status","upstream_duration_s":"$upstream_response_time"}';

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    access_log /var/log/nginx/access.log json;   # the nginx image links this file to stdout
    client_max_body_size 101m;   # bulk ZIP limit (backend config.yaml api.max_zip_mb) + slack

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' blob: data:; style-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host ${BACKEND_HOST};
        proxy_ssl_server_name on;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 240s;   # = Container Apps ingress limit; a cold start waits for the models to load
        proxy_send_timeout 60s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
